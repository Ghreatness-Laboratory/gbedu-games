{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@gbedu/whot-engine": ["packages/whot-engine/src/index.ts"],
      "@gbedu/whot-engine/*": ["packages/whot-engine/src/*"],
      "@gbedu/shared": ["packages/shared/src/index.ts"],
      "@gbedu/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["src", "packages", "server.ts", "apps"]
}
