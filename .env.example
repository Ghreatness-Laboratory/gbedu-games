# Gbedu Games: Naija Whot Platform Environment Variables

# --- FRONTEND-SAFE VARIABLES (Accessible in browser) ---
# Supabase project URL (used by client for auth & storage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anon key (safe for browser usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Socket.IO Server URL (Defaults to window.location.origin if empty)
VITE_SOCKET_URL=

# --- SERVER-ONLY VARIABLES (Never expose in client code or VITE_ vars) ---
# Supabase service role secret key (Bypasses RLS for server snapshot & stats)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server port (AI Studio and dev runs on 3000)
PORT=3000

# Node environment
NODE_ENV=development
